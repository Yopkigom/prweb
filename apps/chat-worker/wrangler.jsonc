{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Chat API Worker. URL: https://prweb-chat.<account>.workers.dev
  // Secrets (set via `wrangler secret put`): NVIDIA_API_KEY
  "name": "prweb-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER_DO", "class_name": "RateLimiterDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiterDO"] }
  ],
  "vars": {
    // Origin allowed by CORS; adjust after first deploy.
    "ALLOWED_ORIGIN": "https://prweb.yopkigom.workers.dev"
  }
}
